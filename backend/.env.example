# ==============================================================================
# OmniRetail Backend — Environment Variables Template (.env.example)
# ==============================================================================
# HOW TO USE:
# 1. Duplicate this file and rename the copy to ".env" in the same directory (backend/).
# 2. Fill in your real values below (e.g. MongoDB connection string, secrets).
# 3. NEVER commit your actual ".env" file into Git version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# The port number on which the Express server listens for incoming HTTP requests.
# Default is 5000 if not specified.
PORT=5000

# The environment mode: 'development' or 'production'.
# In development, detailed errors and debug logs are displayed.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI. Can be a local MongoDB instance or a cloud MongoDB Atlas cluster.
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>
MONGO_URI=mongodb://localhost:27017/omniretail

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# A strong, secret string used by jsonwebtoken to sign and verify user login tokens.
# Tip: Generate a random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ------------------------------------------------------------------------------
# 4. Client & Server URLs (CORS & OAuth)
# ------------------------------------------------------------------------------
# The URL where your frontend React application runs.
# Express uses this for CORS (Cross-Origin Resource Sharing) permissions.
FRONTEND_URL=http://localhost:5173

# The public URL of this backend server (used for Google OAuth callback redirects).
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Optional — for "Login with Google")
# ------------------------------------------------------------------------------
# Obtain these credentials from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# If left empty, Google Sign-In will be safely disabled without crashing the server.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
